# Qloo
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# live | mock — mock returns synthetic "sample data" (no key needed)
QLOO_MODE=live
QLOO_RATE_LIMIT=0.1

# LLM — any OpenAI-compatible chat completions endpoint
# Example: Groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Optional: Google OAuth for YouTube Analytics (feature-flagged, build last)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Spotify (artist lookup + catalog)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional feature flags
YOUTUBE_AUDIENCE_ENABLED=false
LYRICS_ENABLED=true
