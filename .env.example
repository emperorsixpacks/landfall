# Qloo
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# live | mock — mock returns synthetic "sample data" (no key needed)
QLOO_MODE=live
QLOO_RATE_LIMIT=0.1

# LLM — any OpenAI-compatible chat completions endpoint
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional: Google OAuth for YouTube Analytics (feature-flagged, build last)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional feature flags
YOUTUBE_AUDIENCE_ENABLED=false
